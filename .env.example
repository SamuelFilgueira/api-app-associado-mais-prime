# ══════════════════════════════════════════════════════════════════
# Benefícios API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://app-dev.texvngroup.com.br

# ── Banco de Dados (MySQL via Prisma) ───────────────────────────
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# Ajuste de pool do Prisma para cargas altas de leitura
PRISMA_CONNECTION_LIMIT=40
PRISMA_POOL_TIMEOUT=30

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_chave_forte

# ── Redis / BullMQ ──────────────────────────────────────────────
# Desenvolvimento local: localhost (Redis rodando via "docker run" ou instalado)
# Em Docker Compose: o docker-compose.yml sobrescreve automaticamente com "redis"
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Admin Panel ─────────────────────────────────────────────────
ADMIN_PANEL_TOKEN=

# ── SGA ─────────────────────────────────────────────────────────
SGA_TOKEN=

# ── Rastreamento M7 ────────────────────────────────────────────
M7_API_BASE_URL_HOMOLOG=
MO7_TOKEN_HOMOLOG=
M7_WEBHOOK_TOKEN=
# Concorrência de reverse geocode em lote (1-64)
M7_REV_GEOCODE_CONCURRENCY=16
# Cria indices de performance no nominatim_rj.placex (best effort)
M7_NOMINATIM_AUTO_ENSURE_INDEXES=true

# ── Rastreamento Lógica Soluções ────────────────────────────────
LOGICA_TOKEN=
LOGICA_API_BASE_URL=

# ── Rastreamento Softruck ───────────────────────────────────────
SOFTRUCK_API_BASE_URL=
SOFTRUCK_TOKEN=
PUBLIC_KEY_SOFTRUCK=

# ── CEP Aberto ──────────────────────────────────────────────────
CEPABERTO_TOKEN=

# ── Alloyal (Benefícios) ───────────────────────────────────────
BASE_URL_ALLOYAL=
API_SECRET_ALLOYAL=
