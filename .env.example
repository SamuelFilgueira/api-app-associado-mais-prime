# ══════════════════════════════════════════════════════════════════
# Benefícios API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
#
# ATENÇÃO: a aplicação NÃO carrega .env por conta própria (não há dotenv
# nem ConfigModule). As variáveis precisam existir no ambiente do processo:
#   - Docker Compose: já resolvido pelo `env_file: .env`
#   - Local/VPS sem Docker: exportar as variáveis ou usar
#     `node --env-file=.env dist/main`
# ══════════════════════════════════════════════════════════════════

# ── Tenant (multi-base) ─────────────────────────────────────────
# Define quais bases (baseOrigin) existem NESTE deploy e como o nome de
# cada base vira nome de variável de ambiente.
#
# Formato: NOME[:SUFIXO], separado por vírgula.
#   TENANT_BASES=MAIS_PRIME:,MAIS_PRIME_RS:_RS   → deploy Mais Prime (2 bases)
#   TENANT_BASES=HERTZ                           → deploy Hertz (1 base)
#
# O SUFIXO é aplicado às envs de integração (LOGICA_TOKEN_RS, MO7_TOKEN_RS...).
# As envs do SGA usam sempre o NOME da base (USER_SGA_MAIS_PRIME_RS).
# Sem ":", a primeira base fica sem sufixo e as demais usam "_<NOME>".
TENANT_BASES=HERTZ

# Base usada como fallback quando não é possível resolver a base do
# usuário (JWT ou banco). Default: a primeira de TENANT_BASES.
TENANT_DEFAULT_BASE=HERTZ

# Integrações cujas credenciais são obrigatórias no boot (por base).
# "sga" é atalho para sgaUser + sgaPassword + sgaBaseToken.
# Remova o que a empresa ainda não contratou para não travar o boot.
# Default: sga,softruckPublicKey,logica
TENANT_REQUIRED_INTEGRATIONS=sga

# ── Identidade da empresa (branding) ────────────────────────────
TENANT_NAME=Hertz
# Remetente dos e-mails. Default: "<TENANT_NAME> App"
TENANT_APP_NAME=Hertz App
# Nome no rodapé dos relatórios PDF. Default: TENANT_NAME
TENANT_REPORT_NAME=Hertz
# Logo usada nos PDFs (caminho relativo ao diretório da aplicação)
TENANT_LOGO_PATH=assets/Logo.png
# URL base dos links de documentos. Default: APP_URL
TENANT_DOCUMENTS_BASE_URL=

# ── App ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://api.suadominio.com.br

# ── Banco de Dados (MySQL via Prisma) ───────────────────────────
# MySQL instalado na própria VPS (fora do Docker):
#   host.docker.internal (Docker Desktop) ou o IP do gateway da rede docker
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# Ajuste de pool do Prisma para cargas altas de leitura
PRISMA_CONNECTION_LIMIT=40
PRISMA_POOL_TIMEOUT=30

# ── JWT ──────────────────────────────────────────────────────────
# OBRIGATORIAMENTE diferente por empresa — um segredo compartilhado
# faz o token de uma empresa autenticar na API da outra.
# Gerar com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# ── Redis / BullMQ ──────────────────────────────────────────────
# Em Docker Compose o valor é sobrescrito automaticamente para "redis"
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Analytics ───────────────────────────────────────────────────
# Chave HMAC de hash de identificadores. NUNCA reutilizar entre empresas
# (permitiria correlacionar usuários de bases diferentes).
ANALYTICS_SECRET=
ANALYTICS_LINK_USER_ENABLED=true
ANALYTICS_RATE_LIMIT_ENABLED=true
ANALYTICS_RECEIPTS_TTL_DAYS=30
ANALYTICS_DEBUG_PAYLOADS_ENABLED=false
ANALYTICS_DEBUG_PAYLOAD_TTL_DAYS=7

# ── Admin Panel ─────────────────────────────────────────────────
ADMIN_PANEL_TOKEN=

# ── Endpoints de teste ──────────────────────────────────────────
ENABLE_TEST_ENDPOINTS=false

# ══════════════════════════════════════════════════════════════════
# CREDENCIAIS POR BASE
#
# Os nomes abaixo assumem TENANT_BASES=HERTZ (base única, sem sufixo).
# Em um deploy com mais de uma base, replique o bloco usando o sufixo
# configurado. Exemplo para TENANT_BASES=MAIS_PRIME:,MAIS_PRIME_RS:_RS:
#   USER_SGA_MAIS_PRIME / USER_SGA_MAIS_PRIME_RS
#   LOGICA_TOKEN        / LOGICA_TOKEN_RS
#   MO7_TOKEN           / MO7_TOKEN_RS
# ══════════════════════════════════════════════════════════════════

# ── SGA / Hinova (usa o NOME da base) ───────────────────────────
USER_SGA_HERTZ=
PASSWORD_SGA_HERTZ=
TOKEN_BASE_SGA_HERTZ=

# ── Rastreamento M7 ─────────────────────────────────────────────
M7_API_BASE_URL=
MO7_TOKEN=
M07_CODIGO=
M7_WEBHOOK_TOKEN=
M7_API_BASE_URL_HOMOLOG=
MO7_TOKEN_HOMOLOG=
# Concorrência de reverse geocode em lote (1-64)
M7_REV_GEOCODE_CONCURRENCY=16
M7_REV_GEOCODE_TIMEOUT_MS=900
# Reverse geocode via Nominatim próprio (PostgreSQL). Deixe false até
# haver uma instância provisionada na VPS.
M7_NOMINATIM_ENABLED=false
M7_NOMINATIM_DB=
M7_NOMINATIM_TABLE=
M7_NOMINATIM_AUTO_ENSURE_INDEXES=true

# ── Rastreamento Lógica Soluções ────────────────────────────────
LOGICA_TOKEN=
LOGICA_API_BASE_URL=
LOGICA_API_NUMBER=

# ── Rastreamento Softruck ───────────────────────────────────────
SOFTRUCK_API_BASE_URL=
SOFTRUCK_TOKEN=
USERNAME_SOFTRUCK=
PASSWORD_SOFTRUCK=
PUBLIC_KEY_SOFTRUCK=
SOFTRUCK_REV_GEOCODE_TIMEOUT_MS=

# ── Alloyal / Lecupon (Benefícios) ──────────────────────────────
BASE_URL_ALLOYAL=
API_SECRET_ALLOYAL=
ALLOYAL_BUSINESS_ID=
ALLOYAL_BUSINESS_CNPJ=
x_clientemployee_email=
x_clientemployee_token=

# ── Clubgas (Combustível) ───────────────────────────────────────
TOKEN_API_CLUBGAS=

# ── E-mail: AWS SES (principal) ─────────────────────────────────
MAIL_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── E-mail: Gmail SMTP (revistoria/cobrança) ───────────────────
GMAIL_USER=
SENHA_APP=
# Destinatários internos. Default: e-mails da Mais Prime — trocar!
MAIL_TO_PREVIA=
MAIL_TO_COBRANCA=

# ── Suri (WhatsApp) ─────────────────────────────────────────────
suri_baseUrl=
token_suri=
suri_template_id=
suri_template_id_boleto_pago=
channelId=
sendTo=

# ── CEP Aberto ──────────────────────────────────────────────────
CEPABERTO_TOKEN=

# ── Puppeteer (PDFs) ────────────────────────────────────────────
# No Docker o Dockerfile já define /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=
