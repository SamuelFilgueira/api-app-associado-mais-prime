# ══════════════════════════════════════════════════════════════════
# Benefícios API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
#
# ATENÇÃO: a aplicação NÃO carrega .env por conta própria (não há dotenv
# nem ConfigModule). As variáveis precisam existir no ambiente do processo:
#   - Docker Compose: já resolvido pelo `env_file: .env`
#   - Local/VPS sem Docker: exportar as variáveis ou usar
#     `node --env-file=.env dist/main`
# ══════════════════════════════════════════════════════════════════

# ── Tenant (multi-base) ─────────────────────────────────────────
# Define quais bases (baseOrigin) existem NESTE deploy e como o nome de
# cada base vira nome de variável de ambiente.
#
# Formato: NOME[:SUFIXO], separado por vírgula.
#   TENANT_BASES=MAIS_PRIME:,MAIS_PRIME_RS:_RS   → deploy Mais Prime (2 bases)
#   TENANT_BASES=HERTZ                           → deploy Hertz (1 base)
#
# O SUFIXO é aplicado às envs de integração (LOGICA_TOKEN_RS, MO7_TOKEN_RS...).
# As envs do SGA usam sempre o NOME da base (USER_SGA_MAIS_PRIME_RS).
# Sem ":", a primeira base fica sem sufixo e as demais usam "_<NOME>".
TENANT_BASES=HERTZ

# Base usada como fallback quando não é possível resolver a base do
# usuário (JWT ou banco). Default: a primeira de TENANT_BASES.
TENANT_DEFAULT_BASE=HERTZ

# Integrações cujas credenciais são obrigatórias no boot (por base).
# "sga" é atalho para sgaUser + sgaPassword + sgaBaseToken.
# Remova o que a empresa ainda não contratou para não travar o boot.
# Default: sga,softruckPublicKey,logica
TENANT_REQUIRED_INTEGRATIONS=sga

# ── Identidade da empresa (branding) ────────────────────────────
TENANT_NAME=Hertz
# Remetente dos e-mails. Default: "<TENANT_NAME> App"
TENANT_APP_NAME=Hertz App
# Nome no rodapé dos relatórios PDF. Default: TENANT_NAME
TENANT_REPORT_NAME=Hertz
# Logo usada nos PDFs (caminho relativo ao diretório da aplicação)
TENANT_LOGO_PATH=assets/Logo.png
# Cor de destaque da marca nos relatórios PDF (hex). Default: #FF0000 (Mais Prime).
# Hertz: laranja.
TENANT_BRAND_COLOR=#FF7A00
# URL base dos links de documentos. Default: APP_URL
TENANT_DOCUMENTS_BASE_URL=

# ── App ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://api.suadominio.com.br

# ── Banco de Dados (MySQL via Prisma) ───────────────────────────
# MySQL instalado na própria VPS (fora do Docker):
#   host.docker.internal (Docker Desktop) ou o IP do gateway da rede docker
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# Ajuste de pool do Prisma para cargas altas de leitura
PRISMA_CONNECTION_LIMIT=40
PRISMA_POOL_TIMEOUT=30

# ── JWT ──────────────────────────────────────────────────────────
# OBRIGATORIAMENTE diferente por empresa — um segredo compartilhado
# faz o token de uma empresa autenticar na API da outra.
# Gerar com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# ── Redis / BullMQ ──────────────────────────────────────────────
# Em Docker Compose o valor é sobrescrito automaticamente para "redis"
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Analytics ───────────────────────────────────────────────────
# Chave HMAC de hash de identificadores. NUNCA reutilizar entre empresas
# (permitiria correlacionar usuários de bases diferentes).
ANALYTICS_SECRET=
ANALYTICS_LINK_USER_ENABLED=true
ANALYTICS_RATE_LIMIT_ENABLED=true
ANALYTICS_RECEIPTS_TTL_DAYS=30
ANALYTICS_DEBUG_PAYLOADS_ENABLED=false
ANALYTICS_DEBUG_PAYLOAD_TTL_DAYS=7
# Jornada do usuário (aparelhos logados, modelo/SO, telas com horário).
# Só ligar em ambiente com consentimento dos usuários (dev / VPS de teste).
# Docs: docs/ANALYTICS_JORNADA_USUARIO.md
ANALYTICS_JOURNEY_ENABLED=false
ANALYTICS_JOURNEY_TTL_DAYS=90

# ── Associado da Sorte ──────────────────────────────────────────
# Job periódico (apura sorteios, encerra rodadas, envia lembretes).
# DESLIGADO por padrão (promoção ainda sem aval); só "true" liga. Docs: docs/ASSOCIADO_DA_SORTE.md
ASSOCIADO_SORTE_AGENDADOR=false
# URL do painel (opcional) para o botão "Abrir no painel" do e-mail de retirada.
ASSOCIADO_SORTE_PAINEL_URL=
# Pushes "Sua raspadinha está liberada" por ciclo de 5 s (padrão 500).
ASSOCIADO_SORTE_LEMBRETE_LOTE=500

# ── Admin Panel ─────────────────────────────────────────────────
ADMIN_PANEL_TOKEN=

# ── Endpoints de teste ──────────────────────────────────────────
ENABLE_TEST_ENDPOINTS=false

# ══════════════════════════════════════════════════════════════════
# CREDENCIAIS POR BASE
#
# Os nomes abaixo assumem TENANT_BASES=HERTZ (base única, sem sufixo).
# Em um deploy com mais de uma base, replique o bloco usando o sufixo
# configurado. Exemplo para TENANT_BASES=MAIS_PRIME:,MAIS_PRIME_RS:_RS:
#   USER_SGA_MAIS_PRIME / USER_SGA_MAIS_PRIME_RS
#   LOGICA_TOKEN        / LOGICA_TOKEN_RS
#   MO7_TOKEN           / MO7_TOKEN_RS
# ══════════════════════════════════════════════════════════════════

# ── SGA / Hinova (usa o NOME da base) ───────────────────────────
USER_SGA_HERTZ=
PASSWORD_SGA_HERTZ=
TOKEN_BASE_SGA_HERTZ=
# Failover de token de base (bloqueio temporário da Hinova por "extração de dados",
# HTTP 403): pode-se configurar mais de um token por base com sufixo numérico —
# TOKEN_BASE_SGA_<BASE>1, TOKEN_BASE_SGA_<BASE>2 … (com ou sem o nome puro).
# A API usa o primeiro e alterna para o próximo quando o ativo é bloqueado.
#TOKEN_BASE_SGA_HERTZ1=
#TOKEN_BASE_SGA_HERTZ2=
# Poller de verificação do boleto de reativação (revistoria) — defaults em
# src/sga/config/boleto-verificacao.config.ts. Sem limites, o poller consultava
# o SGA a cada 2 min por boleto não pago, para sempre (padrão que a Hinova
# bloqueia como "comportamento agressivo"). Docs: docs/HINOVA_BLOQUEIO_TOKEN_PROTECOES.md
#BOLETO_VERIFICACAO_MAX_DIAS=30                 # encerra a verificação N dias após a criação do boleto
#BOLETO_VERIFICACAO_INTERVALO_APOS_24H_MIN=10   # boleto com mais de 24h: consulta a cada N min (primeiras 24h: 2 min)
#BOLETO_VERIFICACAO_INTERVALO_APOS_7D_MIN=60    # boleto com mais de 7 dias: consulta a cada N min
#BOLETO_VERIFICACAO_ESPACAMENTO_MS=1500         # espaçamento mínimo entre consultas consecutivas do poller ao SGA
#BOLETO_REATIVACAO_RETRY_INTERVALO_MIN=5        # instabilidade do SGA na aprovação: tenta criar o boleto de novo a cada N min
#BOLETO_REATIVACAO_RETRY_MAX_HORAS=24           # desiste (FALHA + e-mail para a cobrança) N horas após a primeira tentativa
#BOLETO_REATIVACAO_JANELA_VENCIMENTO_DIAS=45    # ao procurar boleto criado à mão no SGA, aceita vencimento de hoje até hoje+N dias

# ── Rastreamento M7 ─────────────────────────────────────────────
M7_API_BASE_URL=
MO7_TOKEN=
M07_CODIGO=
M7_WEBHOOK_TOKEN=
M7_API_BASE_URL_HOMOLOG=
MO7_TOKEN_HOMOLOG=
# Reverse geocode local (MySQL nominatim_rj.placex). Deixe false até haver a base na VPS.
M7_NOMINATIM_ENABLED=false
M7_NOMINATIM_DB=
M7_NOMINATIM_TABLE=
# ── Reverse geocode / PDF de contestação V2 (defaults em src/config/m7-geocode.config.ts)
# Workers simultâneos do pool de geocode (1-16). Cada um usa até 3 conexões MySQL.
M7_REV_GEOCODE_CONCURRENCY=8
# Ponto a até N metros de uma âncora já geocodificada herda o endereço dela (0 desliga)
M7_REV_GEOCODE_HERANCA_METROS=20
# Entradas máximas do cache de endereços em memória
M7_REV_GEOCODE_MEM_CACHE_MAX=50000
# Orçamento (ms) de geocode por requisição; excedido → "lat, lon" nos pontos restantes
M7_REV_GEOCODE_BUDGET_MS=90000
# TTL (s) do cache de endereços no Redis, renovado a cada hit (default 7 dias)
M7_REV_GEOCODE_REDIS_TTL_SEG=604800
# Intervalo mínimo (s) entre linhas do PDF de contestação V2 (0 desliga a amostragem)
M7_CONTESTACAO_INTERVALO_MIN_SEG=10
# Pontos por chunk no streaming do PDF (geocode → escreve → envia)
M7_CONTESTACAO_CHUNK_PONTOS=500

# ── Rastreamento Lógica Soluções ────────────────────────────────
LOGICA_TOKEN=
LOGICA_API_BASE_URL=
LOGICA_API_NUMBER=

# ── Rastreamento Softruck ───────────────────────────────────────
SOFTRUCK_API_BASE_URL=
SOFTRUCK_TOKEN=
USERNAME_SOFTRUCK=
PASSWORD_SOFTRUCK=
PUBLIC_KEY_SOFTRUCK=
SOFTRUCK_REV_GEOCODE_TIMEOUT_MS=

# ── Alloyal / Lecupon (Benefícios) ──────────────────────────────
BASE_URL_ALLOYAL=
API_SECRET_ALLOYAL=
ALLOYAL_BUSINESS_ID=
ALLOYAL_BUSINESS_CNPJ=
x_clientemployee_email=
x_clientemployee_token=

# ── Clubgas (Combustível) ───────────────────────────────────────
TOKEN_API_CLUBGAS=

# ── E-mail: provedor da redefinição de senha ────────────────────
# ses (default) = Amazon SES (MAIL_FROM + AWS_*), usado pela Mais Prime.
# gmail = SMTP do Gmail com senha de app (GMAIL_USER + SENHA_APP), usado pela
# Hertz enquanto não há conta SES. Os demais e-mails são sempre Gmail.
MAIL_PASSWORD_RESET_PROVIDER=ses

# ── E-mail: AWS SES (principal) ─────────────────────────────────
MAIL_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── E-mail: Gmail SMTP (revistoria/cobrança) ───────────────────
GMAIL_USER=
SENHA_APP=
# Destinatários internos. Default: e-mails da Mais Prime — trocar!
MAIL_TO_PREVIA=
MAIL_TO_COBRANCA=

# ── Suri (WhatsApp) ─────────────────────────────────────────────
suri_baseUrl=
token_suri=
suri_template_id=
suri_template_id_boleto_pago=
channelId=
sendTo=

# ── CEP Aberto ──────────────────────────────────────────────────
CEPABERTO_TOKEN=

# ── Puppeteer (PDFs) ────────────────────────────────────────────
# No Docker o Dockerfile já define /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# ── Atualizações OTA self-hosted (expo-updates) ─────────────────────────
# Docs: docs/EXPO_UPDATES_OTA.md. Tudo opcional; a feature funciona só com o
# volume updates/ montado (docker-compose já monta).
# Chave privada RSA gerada por `npx expo-updates codesigning:generate`.
# Use UMA das duas formas: caminho do .pem OU conteúdo em base64 (1 linha).
#   base64 -w0 keys/private-key.pem            (Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys\private-key.pem"))  (PowerShell)
EXPO_UPDATES_PRIVATE_KEY_PATH=
EXPO_UPDATES_PRIVATE_KEY_BASE64=
# keyid declarado no app.json (updates.codeSigningMetadata.keyid). Default: main
EXPO_UPDATES_KEY_ID=main
# Base pública nas URLs dos assets do manifest. Default: APP_URL.
# "auto" = usar o host de cada requisição (só para dev com túnel; em produção use URL fixa)
EXPO_UPDATES_PUBLIC_URL=
# Pasta dos releases. Default: ./updates
EXPO_UPDATES_DIR=
# Tamanho máximo do zip de publicação (MB). Default: 200
EXPO_UPDATES_UPLOAD_LIMIT_MB=200

# ── Régua de notificações push de boletos (SGA) — v2, doc do gestor 10/09/2026 ──
# Docs: docs/BOLETO_NOTIFICACAO_ROTINA.md. Etapas: DM5 (D-5), D0, D1 (D+1), D5, D6, D20 (D+20).
# Âncora: vencimento EFETIVO (data_vencimento do SGA, já prorrogado para dia útil).
# Todas têm default; só ENABLED é obrigatória para ligar o cron.
BOLETO_NOTIFICACAO_ENABLED=false            # true liga o agendamento diário (execução manual funciona sempre)
BOLETO_NOTIFICACAO_HORARIO=11:00            # HH:mm no fuso America/Sao_Paulo (régua: 11:00)
#BOLETO_NOTIFICACAO_OFFSET_DM5=5            # janela pré-vencimento: D-5..D-1
#BOLETO_NOTIFICACAO_OFFSET_D1=1
#BOLETO_NOTIFICACAO_OFFSET_D5=5
#BOLETO_NOTIFICACAO_OFFSET_D6=6
#BOLETO_NOTIFICACAO_OFFSET_D20=20
#BOLETO_NOTIFICACAO_D20_ALCANCE=40             # atraso além do D+20 que ainda recebe D+20 no catch-up (20..20+N dias)
#BOLETO_NOTIFICACAO_CODIGOS_TIPO_BOLETO=1,5 # restringe aos tipos (1=MENSALIDADE, 5=FECHAMENTO); vazio = todos
#BOLETO_NOTIFICACAO_D20_ALCANCE=40          # catch-up: atraso além do D+20 que ainda recebe a D+20 (faixa 20..20+N)
#BOLETO_NOTIFICACAO_SITUACOES_SUSPENSO=INADIMPLENTE,INADIMPLENTE +90  # exigido em D6/D20; vazio = sem filtro extra
BOLETO_NOTIFICACAO_QTD_POR_PAGINA=500
BOLETO_NOTIFICACAO_PAUSA_ENTRE_PAGINAS_MS=60000   # pausa entre páginas da consulta ao SGA (evita bloqueio por extração de dados); 0 desliga
BOLETO_NOTIFICACAO_RECEIPTS_DELAY_MIN=15    # minutos até consultar os receipts do Expo
#BOLETO_NOTIFICACAO_TENANTS=MAIS_PRIME,MAIS_PRIME_RS   # default: todas as bases de TENANT_BASES
# Textos por etapa (tokens: {nome}, {placa}, {mes}, {data}=DD/MM, {vencimento}=dd/mm/yyyy, {quantidade}).
# Defaults = textos oficiais da régua; use as envs só para sobrescrever:
#BOLETO_NOTIFICACAO_MSG_DM5_TITULO= / _CORPO=
#BOLETO_NOTIFICACAO_MSG_D0_TITULO=  / _CORPO=
#BOLETO_NOTIFICACAO_MSG_D1_TITULO=  / _CORPO=
#BOLETO_NOTIFICACAO_MSG_D5_TITULO=  / _CORPO=
#BOLETO_NOTIFICACAO_MSG_D6_TITULO=  / _CORPO=
#BOLETO_NOTIFICACAO_MSG_D20_TITULO= / _CORPO=
# Somente DEV/homologação: JSON local no formato do SGA usado no lugar da API (ver docs)
#BOLETO_NOTIFICACAO_SGA_MOCK_FILE=test/fixtures/sga-boletos-periodo.mock.json
#SGA_API_BASE_URL=https://api.hinova.com.br/api/sga/v2

# ══════════════════════════════════════════════════════════════════
# OPERAÇÃO E ESCALA (papéis de processo, Redis com senha, log, borda)
#
# O docker-compose.yml (deploy padrão, um container) fixa APP_ROLE=all,
# REDIS_HOST=redis e PORT=3001. No docker-compose.escala.yml, APP_ROLE,
# LOG_FORMAT, TRUST_PROXY, REDIS_HOST e PRISMA_CONNECTION_LIMIT são definidos
# POR SERVIÇO. O que o compose define vence o que estiver aqui.
# ══════════════════════════════════════════════════════════════════
# Papel do processo: api (HTTP, só produz jobs) | worker (filas e agendadores) | pdf (só a fila de PDF) | all (tudo junto; padrão).
APP_ROLE=all
# Senha do Redis. Opcional no docker-compose.yml (com ela, o Redis sobe exigindo senha e a API a usa; sem ela, sobe sem senha, publicado só em 127.0.0.1). OBRIGATÓRIA no docker-compose.escala.yml. Gerar com: openssl rand -hex 32
REDIS_PASSWORD=
# Formato do log: json (uma linha por evento; padrão em produção) | text (saída colorida do Nest; padrão fora de produção).
#LOG_FORMAT=json
# Nível mínimo de log: error | warn | log | debug | verbose. Padrão: log em produção, debug fora.
#LOG_LEVEL=log
# Proxies confiáveis à frente da API: 1 atrás do Nginx (req.ip = IP do cliente); false desliga; vazio confia só em loopback e rede privada.
#TRUST_PROXY=1
# Origens aceitas no CORS, separadas por vírgula (ex.: https://painel.exemplo.com.br). Vazio = qualquer origem, com aviso no boot em produção.
CORS_ORIGINS=
# Swagger em /docs: em produção só sobe com true (fora de produção o padrão é ligado).
#SWAGGER_ENABLED=false
# Se definido, GET /metrics exige "Authorization: Bearer <token>"; vazio = responde só a IP privado/loopback (o Nginx bloqueia /metrics para fora).
METRICS_TOKEN=
# true aplica também as políticas de rate limit que nascem só em modo observação (calibrar antes com rate_limit_hits_total).
RATE_LIMIT_ENFORCE_ALL=false
# PDFs renderizados ao mesmo tempo pelo processo que tem o Chromium (1 a 8; padrão 2). Cada um custa memória do serviço pdf.
PDF_CONCORRENCIA=2
# Imagem usada pelo docker compose. O ops/deploy.sh (topologia de escala) define sozinho; sem ela o compose constrói e usa beneficios-api:local.
#APP_IMAGE=ghcr.io/dono/repositorio:<sha-do-commit>

# ── Demais ajustes de operação (todos opcionais; o valor comentado é o padrão) ──
# Mascara CPF, token e senha nas linhas de log.
#LOG_REDIGIR_PII=true
# Teto do corpo JSON: padrão para a API e o maior, só nas rotas de revistoria e do cronograma do Associado da Sorte.
#BODY_LIMIT_PADRAO=1mb
#BODY_LIMIT_GRANDE=20mb
# Liga o endpoint /metrics e o limitador de requisições.
#METRICS_ENABLED=true
#RATE_LIMIT_ENABLED=true
# Quanto a API espera o PDF pedido ao processo `pdf` antes de desistir (ms).
#PDF_PRAZO_MS=120000
# Diretório de troca de arquivos entre a API e o processo `pdf` (só na topologia de escala; lá é o volume pdf-tmp).
#PDF_TMP_DIR=/app/tmp/pdf
# Redis com ACL (Redis 6+) ou em outro índice.
#REDIS_USERNAME=
#REDIS_DB=0

# ── Hinova (SGA): cache, orçamento e endereço ──
# Segundos em cache das leituras repetidas pelo app; 0 desliga o cache daquela leitura.
#HINOVA_CACHE_ASSOCIADO_SEG=300
#HINOVA_CACHE_BOLETOS_SEG=120
#HINOVA_CACHE_PRODUTOS_SEG=21600
# Por quanto tempo um valor VENCIDO ainda é servido se a Hinova estiver fora. 0 = não serve (decisão de produto, tela a tela).
#HINOVA_CACHE_ANTIGO_SEG=0
# Chamadas por minuto por token de base antes de a rotação preferir outro token. 0 = só mede.
#HINOVA_ORCAMENTO_POR_MINUTO=0
# Aponta a integração para um servidor simulado (testes de integração e de carga). NÃO definir em produção.
#HINOVA_SGA_BASE_URL=

# ── Alloyal (clube de vantagens): cache do catálogo ──
# Segundos em cache do que é igual para todos os associados da base; 0 desliga o cache daquele recurso.
# Zere se a Alloyal passar a segmentar ofertas por usuário dentro do mesmo business.
#ALLOYAL_CACHE_CATEGORIAS_SEG=21600
#ALLOYAL_CACHE_DESTAQUES_SEG=10800
#ALLOYAL_CACHE_ORGANIZACOES_SEG=3600

# ── Reverse geocode ──
# Teto de consultas simultâneas ao Nominatim no processo. Padrão: derivado de PRISMA_CONNECTION_LIMIT.
#M7_REV_GEOCODE_MAX_CONSULTAS=

# ── Retenção (expurgo diário às 03:30). Tabelas de negócio: 0 = não apaga nada (padrão) ──
#RETENCAO_NOTIFICACOES_DIAS=0
#RETENCAO_WEBHOOK_EVENTOS_DIAS=0
#RETENCAO_VERSAO_LOG_DIAS=0
#RETENCAO_ANALYTICS_RECIBOS_DIAS=0
# Tabelas técnicas (estado de trabalho):
#RETENCAO_OUTBOX_DIAS=7
#RETENCAO_PUSH_ENTREGAS_DIAS=90
