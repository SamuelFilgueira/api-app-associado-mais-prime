generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                            Int            @id @default(autoincrement())
  name                          String
  cpf                           String         @unique(map: "User_cpf_key")
  email                         String
  passwordHash                  String
  isActive                      Boolean        @default(true)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  latitude                      Float?
  longitude                     Float?
  primeiroLogin                 Boolean        @default(false)
  profilePhotoUrl               String?
  address                       String?
  cep                           String?
  plate                         String?
  acceptsMarketingNotifications Boolean        @default(true)
  notificacaoIgnicao            Boolean        @default(false)
  role                          UserRole       @default(USER)
  ancoraAtiva                   Boolean        @default(false)
  expoPushToken                 String?        @db.VarChar(255)
  // Base de origem (tenant). Deixou de ser enum para que cada empresa do
  // grupo defina suas bases via TENANT_BASES, sem migration de schema.
  // Validação dos valores aceitos: src/config/tenant.config.ts
  baseOrigin                    String?        @db.VarChar(50)
  totalEconomizado              Float          @default(0)
  notifications                 Notification[]
  userVehicles                  UserVehicle[]
  fuelSessions                  FuelSession[]
}

model workshop {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  email            String?           @db.VarChar(150)
  shortDescription String            @db.VarChar(100)
  phone            String
  phoneSecondary   String?
  whatsapp         String?
  description      String            @db.VarChar(400)
  isActive         Boolean           @default(true)
  featuredInApp    Boolean           @default(false)
  latitude         Float?
  longitude        Float?
  cep              String
  address          String
  district         String
  number           String
  complement       String?
  city             String
  state            State
  mapFrameUrl      String?
  photoFrontUrl    String?
  photoBackUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  services         Json?
  specialty        WorkshopSpecialty @default(CARRO)
}

model AdminPanelUser {
  id                             Int                             @id @default(autoincrement())
  name                           String                          @db.VarChar(150)
  password                       String                          @db.VarChar(255)
  email                          String                          @unique(map: "AdminPanelUser_email_key") @db.VarChar(150)
  role                           AdminPanelRole
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  marketingNotificationAuditLogs MarketingNotificationAuditLog[]

  @@index([role], map: "AdminPanelUser_role_idx")
}

model MarketingNotificationAuditLog {
  id                 Int            @id @default(autoincrement())
  adminPanelUserId   Int
  title              String         @db.VarChar(255)
  body               String         @db.Text
  messagePayload     Json
  status             String         @default("REQUESTED") @db.VarChar(20)
  sentCount          Int?
  skippedCount       Int?
  errorMessage       String?        @db.VarChar(500)
  normalizedAt       String         @db.VarChar(19)
  normalizedTimezone String         @db.VarChar(64)
  requestedAt        DateTime       @default(now())
  processedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  adminPanelUser     AdminPanelUser @relation(fields: [adminPanelUserId], references: [id], onDelete: Restrict, map: "MarketingNotificationAuditLog_adminPanelUserId_fkey")

  @@index([adminPanelUserId], map: "MarketingNotificationAuditLog_adminPanelUserId_idx")
  @@index([requestedAt], map: "MarketingNotificationAuditLog_requestedAt_idx")
  @@index([status], map: "MarketingNotificationAuditLog_status_idx")
}

model AnalyticsActionDaily {
  id         Int      @id @default(autoincrement())
  day        DateTime @db.Date
  platform   String   @db.VarChar(10)
  appVersion String   @db.VarChar(20)
  action     String   @db.VarChar(60)
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([day, platform, appVersion, action], map: "AnalyticsActionDaily_composite_key")
  @@index([appVersion], map: "AnalyticsActionDaily_appVersion_idx")
  @@index([day], map: "AnalyticsActionDaily_day_idx")
  @@index([platform], map: "AnalyticsActionDaily_platform_idx")
}

/// Um aparelho por dia. `appVersion` é dimensão informativa (a primeira vista
/// no dia) e NÃO participa da unicidade — senão o aparelho que atualiza o app
/// no meio do dia contaria duas vezes, inflando a plataforma que atualiza
/// mais rápido justamente nos dias de rollout.
model AnalyticsDailyUniqueInstall {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  installHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, installHash], map: "AnalyticsDailyUniqueInstall_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueInstall_day_idx")
}

/// Uma sessão por dia. Mesma regra: `appVersion` fora da unicidade.
model AnalyticsDailyUniqueSession {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  sessionHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, sessionHash], map: "AnalyticsDailyUniqueSession_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueSession_day_idx")
}

/// Primeira aparição de cada aparelho — fonte de "instalações novas" e coortes
/// de retenção. Populada na ingestão; backfill feito na migration a partir de
/// AnalyticsDailyUniqueInstall. Sem TTL: é a memória de aquisição da base.
model AnalyticsInstallFirstSeen {
  id           Int      @id @default(autoincrement())
  installHash  String   @unique(map: "AnalyticsInstallFirstSeen_installHash_key") @db.VarChar(64)
  platform     String   @db.VarChar(10)
  appVersion   String   @db.VarChar(20)
  firstSeenDay DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([firstSeenDay], map: "AnalyticsInstallFirstSeen_firstSeenDay_idx")
  @@index([platform], map: "AnalyticsInstallFirstSeen_platform_idx")
}

model AnalyticsFormDaily {
  id             Int      @id @default(autoincrement())
  day            DateTime @db.Date
  platform       String   @db.VarChar(10)
  appVersion     String   @db.VarChar(20)
  screen         String   @db.VarChar(60)
  form           String   @db.VarChar(60)
  startedCount   Int      @default(0)
  submittedCount Int      @default(0)
  successCount   Int      @default(0)
  errorCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, platform, appVersion, screen, form], map: "AnalyticsFormDaily_composite_key")
  @@index([appVersion], map: "AnalyticsFormDaily_appVersion_idx")
  @@index([day], map: "AnalyticsFormDaily_day_idx")
  @@index([platform], map: "AnalyticsFormDaily_platform_idx")
}

model AnalyticsScreenDaily {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  screen      String   @db.VarChar(60)
  viewCount   Int      @default(0)
  totalTimeMs Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, platform, appVersion, screen], map: "AnalyticsScreenDaily_composite_key")
  @@index([appVersion], map: "AnalyticsScreenDaily_appVersion_idx")
  @@index([day], map: "AnalyticsScreenDaily_day_idx")
  @@index([platform], map: "AnalyticsScreenDaily_platform_idx")
}

model AnalyticsSessionDaily {
  id            Int      @id @default(autoincrement())
  day           DateTime @db.Date
  platform      String   @db.VarChar(10)
  appVersion    String   @db.VarChar(20)
  sessionsCount Int      @default(0)
  installsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([day, platform, appVersion], map: "AnalyticsSessionDaily_composite_key")
  @@index([day], map: "AnalyticsSessionDaily_day_idx")
}

model AnalyticsSummaryReceipt {
  id                   Int      @id @default(autoincrement())
  receivedAt           DateTime @default(now())
  periodStart          DateTime
  periodEnd            DateTime
  platform             String   @db.VarChar(10)
  appVersion           String   @db.VarChar(20)
  runtimeVersion       String?  @db.VarChar(20)
  installHash          String   @db.VarChar(64)
  sessionHash          String   @db.VarChar(64)
  acceptedScreensCount Int      @default(0)
  acceptedActionsCount Int      @default(0)
  acceptedFormsCount   Int      @default(0)
  discardedItemsCount  Int      @default(0)
  validationStatus     String   @db.VarChar(20)
  payloadHash          String   @db.VarChar(64)
  createdAt            DateTime @default(now())
  analyticsUserId      Int?

  @@index([appVersion], map: "AnalyticsSummaryReceipt_appVersion_idx")
  @@index([payloadHash], map: "AnalyticsSummaryReceipt_payloadHash_idx")
  @@index([periodStart], map: "AnalyticsSummaryReceipt_periodStart_idx")
  @@index([platform], map: "AnalyticsSummaryReceipt_platform_idx")
  @@index([receivedAt], map: "AnalyticsSummaryReceipt_receivedAt_idx")
}

model Document {
  id               Int          @id @default(autoincrement())
  description      String       @db.VarChar(255)
  documentUrl      String       @db.VarChar(500)
  type             DocumentType
  visibleConsultor Boolean      @default(false)
  visibleAssociado Boolean      @default(false)
  visibleBoth      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model FuelSession {
  id          String   @id @default(uuid())
  userId      Int
  valorAntes  Float
  valorDepois Float?
  diferenca   Float?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FuelSession_userId_fkey")

  @@index([userId, status], map: "FuelSession_userId_status_idx")
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int
  expoPushToken String    @db.VarChar(255)
  title         String    @db.VarChar(255)
  body          String    @db.Text
  data          Json
  read          Boolean   @default(false)
  sentAt        DateTime  @default(now())
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([createdAt], map: "Notification_createdAt_idx")
  @@index([sentAt], map: "Notification_sentAt_idx")
  @@index([userId, read], map: "Notification_userId_read_idx")
}

model Reinspection {
  id            Int                     @id @default(autoincrement())
  userVehicleId Int
  vehicleType   ReinspectionVehicleType
  status        ReinspectionStatus      @default(PENDENTE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  codigoVeiculo Int?
  userVehicle   UserVehicle             @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "Reinspection_userVehicleId_fkey")
  photos        ReinspectionPhoto[]

  @@index([status], map: "Reinspection_status_idx")
  @@index([userVehicleId], map: "Reinspection_userVehicleId_idx")
}

model ReinspectionAnalyst {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReinspectionPayment {
  id             Int         @id @default(autoincrement())
  userVehicleId  Int
  nossoNumero    String?     @unique(map: "ReinspectionPayment_nossoNumero_key") @db.VarChar(50)
  linhaDigitavel String?     @db.VarChar(255)
  linkBoleto     String?     @db.VarChar(500)
  situacaoBoleto String      @default("PENDENTE") @db.VarChar(100)
  boletoCriadoEm DateTime    @default(now())
  pago           Boolean     @default(false)
  pagoEm         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cancelado      Boolean     @default(false)
  userVehicle    UserVehicle @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "ReinspectionPayment_userVehicleId_fkey")

  @@index([boletoCriadoEm], map: "ReinspectionPayment_boletoCriadoEm_idx")
  @@index([pago], map: "ReinspectionPayment_pago_idx")
  @@index([situacaoBoleto], map: "ReinspectionPayment_situacaoBoleto_idx")
  @@index([userVehicleId], map: "ReinspectionPayment_userVehicleId_idx")
}

/// Execução da rotina diária de notificações de boleto (uma linha por
/// tenant × tipo de mensagem × data-alvo). Concentra as métricas de cobertura.
model BoletoNotificacaoExecucao {
  id                     Int                             @id @default(autoincrement())
  tenant                 String                          @db.VarChar(50)
  tipoMensagem           BoletoNotificacaoTipo
  dataReferencia         DateTime                        @db.Date
  dataAlvo               DateTime                        @db.Date
  status                 BoletoNotificacaoExecucaoStatus @default(EM_ANDAMENTO)
  origem                 String                          @default("AGENDADA") @db.VarChar(20)
  dryRun                 Boolean                         @default(false)
  totalRegistrosSga      Int                             @default(0)
  totalPaginasSga        Int                             @default(0)
  totalBoletosElegiveis  Int                             @default(0)
  totalAssociados        Int                             @default(0)
  totalSemUsuario        Int                             @default(0)
  totalSemToken          Int                             @default(0)
  totalIdempotentes      Int                             @default(0)
  totalDuplicadosUsuario Int                             @default(0)
  totalEnfileirados      Int                             @default(0)
  totalEnviados          Int                             @default(0)
  totalEntregues         Int                             @default(0)
  totalFalhas            Int                             @default(0)
  totalTokensInvalidos   Int                             @default(0)
  coberturaElegiveis     Float?
  coberturaEntrega       Float?
  receiptsVerificadosEm  DateTime?
  erro                   String?                         @db.Text
  iniciadoEm             DateTime                        @default(now())
  finalizadoEm           DateTime?
  logs                   BoletoNotificacaoLog[]

  @@index([tenant, dataAlvo, tipoMensagem], map: "BoletoNotificacaoExecucao_tenant_dataAlvo_tipo_idx")
  @@index([iniciadoEm], map: "BoletoNotificacaoExecucao_iniciadoEm_idx")
}

/// Log de cada push da rotina de boletos. A chave única garante idempotência
/// e agrega N boletos do mesmo associado/vencimento em um único disparo.
model BoletoNotificacaoLog {
  id                     Int                       @id @default(autoincrement())
  execucaoId             Int
  tenant                 String                    @db.VarChar(50)
  codigoAssociado        Int
  cpf                    String                    @db.VarChar(11)
  userId                 Int?
  nossoNumero            String?                   @db.VarChar(50)
  quantidadeBoletos      Int                       @default(1)
  dataVencimentoOriginal DateTime                  @db.Date
  tipoMensagem           BoletoNotificacaoTipo
  expoPushToken          String?                   @db.VarChar(255)
  statusEnvio            BoletoNotificacaoStatus   @default(ENFILEIRADO)
  expoTicketId           String?                   @db.VarChar(100)
  expoErro               String?                   @db.VarChar(255)
  mensagemTitulo         String                    @db.VarChar(255)
  mensagemEnviada        String                    @db.Text
  criadoEm               DateTime                  @default(now())
  atualizadoEm           DateTime                  @updatedAt
  execucao               BoletoNotificacaoExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade, map: "BoletoNotificacaoLog_execucaoId_fkey")

  @@unique([tenant, codigoAssociado, dataVencimentoOriginal, tipoMensagem], map: "BoletoNotificacaoLog_idempotencia_key")
  @@index([execucaoId, statusEnvio], map: "BoletoNotificacaoLog_execucaoId_statusEnvio_idx")
  @@index([userId], map: "BoletoNotificacaoLog_userId_idx")
}

model ReinspectionPhoto {
  id              Int                        @id @default(autoincrement())
  reinspectionId  Int
  nomeArquivo     String                     @db.VarChar(255)
  codigoTipo      Int?
  url             String?                    @db.VarChar(500)
  hinovaSituacao  String?                    @db.VarChar(50)
  sentToHinova    Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  status          ReinspectionPhotoStatus
  templatePhotoId Int?
  reinspection    Reinspection               @relation(fields: [reinspectionId], references: [id], onDelete: Cascade, map: "ReinspectionPhoto_reinspectionId_fkey")
  templatePhoto   ReinspectionTemplatePhoto? @relation(fields: [templatePhotoId], references: [id], map: "ReinspectionPhoto_templatePhotoId_fkey")

  @@index([reinspectionId], map: "ReinspectionPhoto_reinspectionId_idx")
  @@index([status], map: "ReinspectionPhoto_status_idx")
  @@index([templatePhotoId], map: "ReinspectionPhoto_templatePhotoId_fkey")
}

model ReinspectionTemplatePhoto {
  id          Int                     @id @default(autoincrement())
  vehicleType ReinspectionVehicleType
  photoUrl    String                  @db.VarChar(500)
  ordem       Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  photos      ReinspectionPhoto[]

  @@unique([vehicleType, ordem], map: "ReinspectionTemplatePhoto_vehicleType_ordem_key")
  @@index([vehicleType], map: "ReinspectionTemplatePhoto_vehicleType_idx")
}

model SliderInfo {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  description String   @db.Text
  imageUrl    String   @db.VarChar(500)
  whatsapp    String?  @db.VarChar(50)
  linkUrl     String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserVehicle {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  chassi               String                @db.VarChar(100)
  plate                String?               @db.VarChar(20)
  externalVehicleCode  String?               @db.VarChar(50)
  isActive             Boolean               @default(true)
  lastSyncAt           DateTime              @default(now())
  reinspectionRequired Boolean               @default(false)
  cortarRastreamento   Boolean               @default(false)
  reinspections        Reinspection[]
  reinspectionPayments ReinspectionPayment[]
  user                 user                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserVehicle_userId_fkey")

  @@unique([userId, chassi], map: "UserVehicle_userId_chassi_key")
  @@index([chassi], map: "UserVehicle_chassi_idx")
  @@index([userId], map: "UserVehicle_userId_idx")
}

model VehicleWebhookEvent {
  id         Int      @id @default(autoincrement())
  chassi     String   @db.VarChar(100)
  evento     String?  @db.VarChar(255)
  tipoevento Int?
  provider   String   @default("M7") @db.VarChar(32)
  payload    Json
  receivedAt DateTime @default(now())
  processed  Boolean  @default(false)

  @@index([chassi], map: "VehicleWebhookEvent_chassi_idx")
  @@index([receivedAt], map: "VehicleWebhookEvent_receivedAt_idx")
  @@index([tipoevento], map: "VehicleWebhookEvent_tipoevento_idx")
}

model AppVersionPolicy {
  id                         Int                       @id @default(autoincrement())
  platform                   String                    @db.VarChar(10)
  minSupportedVersion        String                    @db.VarChar(32)
  minSupportedRuntimeVersion String?                   @db.VarChar(32)
  minSupportedVersionCode    Int?
  minSupportedBuildNumber    Int?
  forceUpdateEnabled         Boolean                   @default(false)
  title                      String                    @default("Atualizacao obrigatoria") @db.VarChar(120)
  message                    String                    @default("Uma nova versao do app esta disponivel. Atualize para continuar.") @db.VarChar(500)
  storeUrl                   String?                   @db.VarChar(500)
  effectiveFrom              DateTime                  @default(now())
  effectiveUntil             DateTime?
  isActive                   Boolean                   @default(true)
  createdBy                  String?                   @db.VarChar(120)
  notes                      String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  validationLogs             AppVersionValidationLog[]

  @@index([platform, isActive, effectiveFrom(sort: Desc)], map: "AppVersionPolicy_platform_active_idx")
}

model AppVersionValidationLog {
  id             Int               @id @default(autoincrement())
  requestId      String?           @db.Char(36)
  platform       String            @db.VarChar(10)
  appVersion     String?           @db.VarChar(32)
  runtimeVersion String?           @db.VarChar(32)
  versionCode    Int?
  buildNumber    Int?
  policyId       Int?
  blocked        Boolean
  reason         String?           @db.VarChar(120)
  userId         Int?
  ipAddress      String?           @db.VarChar(45)
  userAgent      String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  policy         AppVersionPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull, map: "AppVersionValidationLog_policyId_fkey")

  @@index([createdAt(sort: Desc)], map: "AppVersionValidationLog_createdAt_idx")
}

model NotificationPopup {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  linkUrl   String?
  linkLabel String?  @default("Saiba mais")
  active    Boolean  @default(false)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt(sort: Desc)], map: "NotificationPopup_active_createdAt_idx")
}

enum UserRole {
  USER
  ADMIN
}

enum State {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum WorkshopSpecialty {
  CARRO
  MOTO
}

enum ReinspectionVehicleType {
  VEICULOS_LEVES
  MOTOS
  CAMINHOES
}

enum DocumentType {
  TERMO_EVENTO
  TERMO_PAYMENTS
  TERMO_REVISTORIA
  TERMO_USO_REGULAMENTO
}

enum ReinspectionStatus {
  PENDENTE
  EM_ANALISE
  FINALIZADA
  APROVADA
  REPROVADA
}

enum AdminPanelRole {
  REVISTORIA
  EVENTOS
  MARKETING
  COBRANCA
  ADMIN
  RESET_PASSWORD
}

enum ReinspectionPhotoStatus {
  PENDENTE
  APROVADA
  REPROVADA
}

enum BoletoNotificacaoTipo {
  D0
  D5
  D6
}

enum BoletoNotificacaoStatus {
  ENFILEIRADO
  ENVIADO
  ENTREGUE
  FALHA
}

enum BoletoNotificacaoExecucaoStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PULADA
  FALHA
}
