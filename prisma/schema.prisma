generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                            Int             @id @default(autoincrement())
  name                          String
  cpf                           String          @unique(map: "User_cpf_key")
  email                         String          @unique(map: "User_email_key")
  passwordHash                  String
  isActive                      Boolean         @default(true)
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  latitude                      Float?
  longitude                     Float?
  primeiroLogin                 Boolean         @default(false)
  profilePhotoUrl               String?
  address                       String?
  cep                           String?
  plate                         String?
  acceptsMarketingNotifications Boolean         @default(true)
  notificacaoIgnicao            Boolean         @default(false)
  role                          UserRole        @default(USER)
  ancoraAtiva                   Boolean         @default(false)
  expoPushToken                 String?         @db.VarChar(255)
  baseOrigin                    UserBaseOrigin?
  totalEconomizado              Float           @default(0)
  notifications                 Notification[]
  userVehicles                  UserVehicle[]
  fuelSessions                  FuelSession[]
}

model workshop {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  email            String?           @db.VarChar(150)
  shortDescription String            @db.VarChar(100)
  phone            String
  phoneSecondary   String?
  whatsapp         String?
  description      String            @db.VarChar(400)
  isActive         Boolean           @default(true)
  featuredInApp    Boolean           @default(false)
  latitude         Float?
  longitude        Float?
  cep              String
  address          String
  district         String
  number           String
  complement       String?
  city             String
  state            State
  mapFrameUrl      String?
  photoFrontUrl    String?
  photoBackUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  services         Json?
  specialty        WorkshopSpecialty @default(CARRO)
}

model AdminPanelUser {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(150)
  password  String         @db.VarChar(255)
  email     String         @unique(map: "AdminPanelUser_email_key") @db.VarChar(150)
  role      AdminPanelRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([role], map: "AdminPanelUser_role_idx")
}

model AnalyticsActionDaily {
  id         Int      @id @default(autoincrement())
  day        DateTime @db.Date
  platform   String   @db.VarChar(10)
  appVersion String   @db.VarChar(20)
  action     String   @db.VarChar(60)
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([day, platform, appVersion, action], map: "AnalyticsActionDaily_composite_key")
  @@index([appVersion], map: "AnalyticsActionDaily_appVersion_idx")
  @@index([day], map: "AnalyticsActionDaily_day_idx")
  @@index([platform], map: "AnalyticsActionDaily_platform_idx")
}

model AnalyticsDailyUniqueInstall {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  installHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, appVersion, installHash], map: "AnalyticsDailyUniqueInstall_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueInstall_day_idx")
}

model AnalyticsDailyUniqueSession {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  sessionHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, appVersion, sessionHash], map: "AnalyticsDailyUniqueSession_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueSession_day_idx")
}

model AnalyticsFormDaily {
  id             Int      @id @default(autoincrement())
  day            DateTime @db.Date
  platform       String   @db.VarChar(10)
  appVersion     String   @db.VarChar(20)
  screen         String   @db.VarChar(60)
  form           String   @db.VarChar(60)
  startedCount   Int      @default(0)
  submittedCount Int      @default(0)
  successCount   Int      @default(0)
  errorCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, platform, appVersion, screen, form], map: "AnalyticsFormDaily_composite_key")
  @@index([appVersion], map: "AnalyticsFormDaily_appVersion_idx")
  @@index([day], map: "AnalyticsFormDaily_day_idx")
  @@index([platform], map: "AnalyticsFormDaily_platform_idx")
}

model AnalyticsScreenDaily {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  screen      String   @db.VarChar(60)
  viewCount   Int      @default(0)
  totalTimeMs Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, platform, appVersion, screen], map: "AnalyticsScreenDaily_composite_key")
  @@index([appVersion], map: "AnalyticsScreenDaily_appVersion_idx")
  @@index([day], map: "AnalyticsScreenDaily_day_idx")
  @@index([platform], map: "AnalyticsScreenDaily_platform_idx")
}

model AnalyticsSessionDaily {
  id            Int      @id @default(autoincrement())
  day           DateTime @db.Date
  platform      String   @db.VarChar(10)
  appVersion    String   @db.VarChar(20)
  sessionsCount Int      @default(0)
  installsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([day, platform, appVersion], map: "AnalyticsSessionDaily_composite_key")
  @@index([day], map: "AnalyticsSessionDaily_day_idx")
}

model AnalyticsSummaryReceipt {
  id                   Int      @id @default(autoincrement())
  receivedAt           DateTime @default(now())
  periodStart          DateTime
  periodEnd            DateTime
  platform             String   @db.VarChar(10)
  appVersion           String   @db.VarChar(20)
  runtimeVersion       String?  @db.VarChar(20)
  installHash          String   @db.VarChar(64)
  sessionHash          String   @db.VarChar(64)
  acceptedScreensCount Int      @default(0)
  acceptedActionsCount Int      @default(0)
  acceptedFormsCount   Int      @default(0)
  discardedItemsCount  Int      @default(0)
  validationStatus     String   @db.VarChar(20)
  payloadHash          String   @db.VarChar(64)
  createdAt            DateTime @default(now())
  analyticsUserId      Int?

  @@index([appVersion], map: "AnalyticsSummaryReceipt_appVersion_idx")
  @@index([payloadHash], map: "AnalyticsSummaryReceipt_payloadHash_idx")
  @@index([periodStart], map: "AnalyticsSummaryReceipt_periodStart_idx")
  @@index([platform], map: "AnalyticsSummaryReceipt_platform_idx")
  @@index([receivedAt], map: "AnalyticsSummaryReceipt_receivedAt_idx")
}

model Document {
  id               Int          @id @default(autoincrement())
  description      String       @db.VarChar(255)
  documentUrl      String       @db.VarChar(500)
  type             DocumentType
  visibleConsultor Boolean      @default(false)
  visibleAssociado Boolean      @default(false)
  visibleBoth      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model FuelSession {
  id          String   @id @default(uuid())
  userId      Int
  valorAntes  Float
  valorDepois Float?
  diferenca   Float?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FuelSession_userId_fkey")

  @@index([userId, status], map: "FuelSession_userId_status_idx")
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int
  expoPushToken String    @db.VarChar(255)
  title         String    @db.VarChar(255)
  body          String    @db.Text
  data          Json
  read          Boolean   @default(false)
  sentAt        DateTime  @default(now())
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([createdAt], map: "Notification_createdAt_idx")
  @@index([sentAt], map: "Notification_sentAt_idx")
  @@index([userId, read], map: "Notification_userId_read_idx")
}

model Reinspection {
  id            Int                     @id @default(autoincrement())
  userVehicleId Int
  vehicleType   ReinspectionVehicleType
  status        ReinspectionStatus      @default(PENDENTE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  codigoVeiculo Int?
  userVehicle   UserVehicle             @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "Reinspection_userVehicleId_fkey")
  photos        ReinspectionPhoto[]

  @@index([status], map: "Reinspection_status_idx")
  @@index([userVehicleId], map: "Reinspection_userVehicleId_idx")
}

model ReinspectionAnalyst {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReinspectionPayment {
  id             Int         @id @default(autoincrement())
  userVehicleId  Int
  nossoNumero    String?     @unique(map: "ReinspectionPayment_nossoNumero_key") @db.VarChar(50)
  linhaDigitavel String?     @db.VarChar(255)
  linkBoleto     String?     @db.VarChar(500)
  situacaoBoleto String      @default("PENDENTE") @db.VarChar(100)
  boletoCriadoEm DateTime    @default(now())
  pago           Boolean     @default(false)
  pagoEm         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cancelado      Boolean     @default(false)
  userVehicle    UserVehicle @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "ReinspectionPayment_userVehicleId_fkey")

  @@index([boletoCriadoEm], map: "ReinspectionPayment_boletoCriadoEm_idx")
  @@index([pago], map: "ReinspectionPayment_pago_idx")
  @@index([situacaoBoleto], map: "ReinspectionPayment_situacaoBoleto_idx")
  @@index([userVehicleId], map: "ReinspectionPayment_userVehicleId_idx")
}

model ReinspectionPhoto {
  id              Int                        @id @default(autoincrement())
  reinspectionId  Int
  nomeArquivo     String                     @db.VarChar(255)
  codigoTipo      Int?
  url             String?                    @db.VarChar(500)
  hinovaSituacao  String?                    @db.VarChar(50)
  sentToHinova    Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  status          ReinspectionPhotoStatus
  templatePhotoId Int?
  reinspection    Reinspection               @relation(fields: [reinspectionId], references: [id], onDelete: Cascade, map: "ReinspectionPhoto_reinspectionId_fkey")
  templatePhoto   ReinspectionTemplatePhoto? @relation(fields: [templatePhotoId], references: [id], map: "ReinspectionPhoto_templatePhotoId_fkey")

  @@index([reinspectionId], map: "ReinspectionPhoto_reinspectionId_idx")
  @@index([status], map: "ReinspectionPhoto_status_idx")
  @@index([templatePhotoId], map: "ReinspectionPhoto_templatePhotoId_fkey")
}

model ReinspectionTemplatePhoto {
  id          Int                     @id @default(autoincrement())
  vehicleType ReinspectionVehicleType
  photoUrl    String                  @db.VarChar(500)
  ordem       Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  photos      ReinspectionPhoto[]

  @@unique([vehicleType, ordem], map: "ReinspectionTemplatePhoto_vehicleType_ordem_key")
  @@index([vehicleType], map: "ReinspectionTemplatePhoto_vehicleType_idx")
}


model SliderInfo {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  description String   @db.Text
  imageUrl    String   @db.VarChar(500)
  whatsapp    String?  @db.VarChar(50)
  linkUrl     String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserVehicle {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  chassi               String                @db.VarChar(100)
  plate                String?               @db.VarChar(20)
  externalVehicleCode  String?               @db.VarChar(50)
  isActive             Boolean               @default(true)
  lastSyncAt           DateTime              @default(now())
  reinspectionRequired Boolean               @default(false)
  cortarRastreamento   Boolean               @default(false)
  reinspections        Reinspection[]
  reinspectionPayments ReinspectionPayment[]
  user                 user                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserVehicle_userId_fkey")

  @@unique([userId, chassi], map: "UserVehicle_userId_chassi_key")
  @@index([chassi], map: "UserVehicle_chassi_idx")
  @@index([userId], map: "UserVehicle_userId_idx")
}

model VehicleWebhookEvent {
  id         Int      @id @default(autoincrement())
  chassi     String   @db.VarChar(100)
  evento     String?  @db.VarChar(255)
  tipoevento Int?
  provider   String   @default("M7") @db.VarChar(32)
  payload    Json
  receivedAt DateTime @default(now())
  processed  Boolean  @default(false)

  @@index([chassi], map: "VehicleWebhookEvent_chassi_idx")
  @@index([receivedAt], map: "VehicleWebhookEvent_receivedAt_idx")
  @@index([tipoevento], map: "VehicleWebhookEvent_tipoevento_idx")
}

model AppVersionPolicy {
  id                         Int                       @id @default(autoincrement())
  platform                   String                    @db.VarChar(10)
  minSupportedVersion        String                    @db.VarChar(32)
  minSupportedRuntimeVersion String?                   @db.VarChar(32)
  minSupportedVersionCode    Int?
  minSupportedBuildNumber    Int?
  forceUpdateEnabled         Boolean                   @default(false)
  title                      String                    @default("Atualizacao obrigatoria") @db.VarChar(120)
  message                    String                    @default("Uma nova versao do app esta disponivel. Atualize para continuar.") @db.VarChar(500)
  storeUrl                   String?                   @db.VarChar(500)
  effectiveFrom              DateTime                  @default(now())
  effectiveUntil             DateTime?
  isActive                   Boolean                   @default(true)
  createdBy                  String?                   @db.VarChar(120)
  notes                      String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  validationLogs             AppVersionValidationLog[]

  @@index([platform, isActive, effectiveFrom(sort: Desc)], map: "AppVersionPolicy_platform_active_idx")
}

model AppVersionValidationLog {
  id             Int               @id @default(autoincrement())
  requestId      String?           @db.Char(36)
  platform       String            @db.VarChar(10)
  appVersion     String?           @db.VarChar(32)
  runtimeVersion String?           @db.VarChar(32)
  versionCode    Int?
  buildNumber    Int?
  policyId       Int?
  blocked        Boolean
  reason         String?           @db.VarChar(120)
  userId         Int?
  ipAddress      String?           @db.VarChar(45)
  userAgent      String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  policy         AppVersionPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull, map: "AppVersionValidationLog_policyId_fkey")

  @@index([createdAt(sort: Desc)], map: "AppVersionValidationLog_createdAt_idx")
}

enum UserRole {
  USER
  ADMIN
}

enum UserBaseOrigin {
  MAIS_PRIME
  MAIS_PRIME_RS
}

enum State {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum WorkshopSpecialty {
  CARRO
  MOTO
}

enum ReinspectionVehicleType {
  VEICULOS_LEVES
  MOTOS
  CAMINHOES
}

enum DocumentType {
  TERMO_EVENTO
  TERMO_PAYMENTS
  TERMO_REVISTORIA
  TERMO_USO_REGULAMENTO
}

enum ReinspectionStatus {
  PENDENTE
  EM_ANALISE
  FINALIZADA
  APROVADA
  REPROVADA
}

enum AdminPanelRole {
  REVISTORIA
  EVENTOS
  MARKETING
  COBRANCA
  ADMIN
}

enum ReinspectionPhotoStatus {
  PENDENTE
  APROVADA
  REPROVADA
}
