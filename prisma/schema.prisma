generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                            Int                             @id @default(autoincrement())
  name                          String
  cpf                           String                          @unique(map: "User_cpf_key")
  email                         String
  passwordHash                  String
  isActive                      Boolean                         @default(true)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  latitude                      Float?
  longitude                     Float?
  primeiroLogin                 Boolean                         @default(false)
  profilePhotoUrl               String?
  address                       String?
  cep                           String?
  plate                         String?
  acceptsMarketingNotifications Boolean                         @default(true)
  notificacaoIgnicao            Boolean                         @default(false)
  role                          UserRole                        @default(USER)
  ancoraAtiva                   Boolean                         @default(false)
  expoPushToken                 String?                         @db.VarChar(255)
  // Base de origem (tenant). Deixou de ser enum para que cada empresa do
  // grupo defina suas bases via TENANT_BASES, sem migration de schema.
  // Validação dos valores aceitos: src/config/tenant.config.ts
  baseOrigin                    String?                         @db.VarChar(50)
  totalEconomizado              Float                           @default(0)
  notifications                 Notification[]
  userVehicles                  UserVehicle[]
  fuelSessions                  FuelSession[]
  directPartnerRedemptions      DirectPartnerCouponRedemption[]
  sorteCarteira                 SorteCarteira?
  sorteParticipacoes            SorteParticipacao[]
  sorteLembretes                SorteLembrete[]
  sorteGanhadores               SorteGanhador[]
  sorteInscricao                SorteInscricao?

  /// Seleção de destinatários por base (push em massa, régua de boletos).
  @@index([baseOrigin, isActive], map: "User_baseOrigin_isActive_idx")
}

model workshop {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  email            String?           @db.VarChar(150)
  shortDescription String            @db.VarChar(100)
  phone            String
  phoneSecondary   String?
  whatsapp         String?
  description      String            @db.VarChar(400)
  isActive         Boolean           @default(true)
  featuredInApp    Boolean           @default(false)
  latitude         Float?
  longitude        Float?
  cep              String
  address          String
  district         String
  number           String
  complement       String?
  city             String
  state            State
  mapFrameUrl      String?
  photoFrontUrl    String?
  photoBackUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  services         Json?
  specialty        WorkshopSpecialty @default(CARRO)
}

model AdminPanelUser {
  id                             Int                             @id @default(autoincrement())
  name                           String                          @db.VarChar(150)
  password                       String                          @db.VarChar(255)
  email                          String                          @unique(map: "AdminPanelUser_email_key") @db.VarChar(150)
  role                           AdminPanelRole
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  marketingNotificationAuditLogs MarketingNotificationAuditLog[]

  @@index([role], map: "AdminPanelUser_role_idx")
}

/// Auditoria de troca de senha de usuário do app: quem alterou (usuário do
/// painel ou o próprio associado) a senha de qual usuário. Sem FK para
/// preservar o histórico mesmo que o usuário seja removido.
model UserPasswordChangeLog {
  id                  Int      @id @default(autoincrement())
  /// Usuário do app que teve a senha alterada.
  userId              Int
  userCpf             String   @db.VarChar(20)
  userEmail           String?  @db.VarChar(150)
  userName            String?  @db.VarChar(150)
  /// PAINEL_ADMIN (reset pelo painel) | APP (associado trocou a própria senha)
  origem              String   @db.VarChar(20)
  adminPanelUserId    Int?
  adminPanelUserEmail String?  @db.VarChar(150)
  adminPanelUserRole  String?  @db.VarChar(30)
  ipAddress           String?  @db.VarChar(45)
  userAgent           String?  @db.VarChar(500)
  createdAt           DateTime @default(now())

  @@index([userId], map: "UserPasswordChangeLog_userId_idx")
  @@index([adminPanelUserId], map: "UserPasswordChangeLog_adminPanelUserId_idx")
  @@index([createdAt], map: "UserPasswordChangeLog_createdAt_idx")
}

model MarketingNotificationAuditLog {
  id                         Int            @id @default(autoincrement())
  adminPanelUserId           Int
  title                      String         @db.VarChar(255)
  body                       String         @db.Text
  messagePayload             Json
  status                     String         @default("REQUESTED") @db.VarChar(20)
  sentCount                  Int?
  skippedCount               Int?
  errorMessage               String?        @db.VarChar(500)
  normalizedAt               String         @db.VarChar(19)
  normalizedTimezone         String         @db.VarChar(64)
  requestedAt                DateTime       @default(now())
  processedAt                DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  /// Origem do disparo: MARKETING (painel) ou SITUACAO_CADASTRO (planilha).
  tipo                       String         @default("MARKETING") @db.VarChar(30)
  /// Disparo agendado: instante do envio. Nulo = envio imediato.
  scheduledFor               DateTime?
  canceledAt                 DateTime?
  /// Usuário do painel que cancelou o agendamento (sem FK: preserva o histórico).
  canceledByAdminPanelUserId Int?
  adminPanelUser             AdminPanelUser @relation(fields: [adminPanelUserId], references: [id], onDelete: Restrict, map: "MarketingNotificationAuditLog_adminPanelUserId_fkey")

  @@index([adminPanelUserId], map: "MarketingNotificationAuditLog_adminPanelUserId_idx")
  @@index([requestedAt], map: "MarketingNotificationAuditLog_requestedAt_idx")
  @@index([status], map: "MarketingNotificationAuditLog_status_idx")
  @@index([status, scheduledFor], map: "MarketingNotificationAuditLog_status_scheduledFor_idx")
}

model AnalyticsActionDaily {
  id         Int      @id @default(autoincrement())
  day        DateTime @db.Date
  platform   String   @db.VarChar(10)
  appVersion String   @db.VarChar(20)
  action     String   @db.VarChar(60)
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([day, platform, appVersion, action], map: "AnalyticsActionDaily_composite_key")
  @@index([appVersion], map: "AnalyticsActionDaily_appVersion_idx")
  @@index([day], map: "AnalyticsActionDaily_day_idx")
  @@index([platform], map: "AnalyticsActionDaily_platform_idx")
}

/// Um aparelho por dia. `appVersion` é dimensão informativa (a primeira vista
/// no dia) e NÃO participa da unicidade — senão o aparelho que atualiza o app
/// no meio do dia contaria duas vezes, inflando a plataforma que atualiza
/// mais rápido justamente nos dias de rollout.
model AnalyticsDailyUniqueInstall {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  installHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, installHash], map: "AnalyticsDailyUniqueInstall_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueInstall_day_idx")
}

/// Uma sessão por dia. Mesma regra: `appVersion` fora da unicidade.
model AnalyticsDailyUniqueSession {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  sessionHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@unique([day, platform, sessionHash], map: "AnalyticsDailyUniqueSession_unique_key")
  @@index([day], map: "AnalyticsDailyUniqueSession_day_idx")
}

/// Primeira aparição de cada aparelho — fonte de "instalações novas" e coortes
/// de retenção. Populada na ingestão; backfill feito na migration a partir de
/// AnalyticsDailyUniqueInstall. Sem TTL: é a memória de aquisição da base.
model AnalyticsInstallFirstSeen {
  id           Int      @id @default(autoincrement())
  installHash  String   @unique(map: "AnalyticsInstallFirstSeen_installHash_key") @db.VarChar(64)
  platform     String   @db.VarChar(10)
  appVersion   String   @db.VarChar(20)
  firstSeenDay DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([firstSeenDay], map: "AnalyticsInstallFirstSeen_firstSeenDay_idx")
  @@index([platform], map: "AnalyticsInstallFirstSeen_platform_idx")
}

model AnalyticsFormDaily {
  id             Int      @id @default(autoincrement())
  day            DateTime @db.Date
  platform       String   @db.VarChar(10)
  appVersion     String   @db.VarChar(20)
  screen         String   @db.VarChar(60)
  form           String   @db.VarChar(60)
  startedCount   Int      @default(0)
  submittedCount Int      @default(0)
  successCount   Int      @default(0)
  errorCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, platform, appVersion, screen, form], map: "AnalyticsFormDaily_composite_key")
  @@index([appVersion], map: "AnalyticsFormDaily_appVersion_idx")
  @@index([day], map: "AnalyticsFormDaily_day_idx")
  @@index([platform], map: "AnalyticsFormDaily_platform_idx")
}

model AnalyticsScreenDaily {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  platform    String   @db.VarChar(10)
  appVersion  String   @db.VarChar(20)
  screen      String   @db.VarChar(60)
  viewCount   Int      @default(0)
  totalTimeMs Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, platform, appVersion, screen], map: "AnalyticsScreenDaily_composite_key")
  @@index([appVersion], map: "AnalyticsScreenDaily_appVersion_idx")
  @@index([day], map: "AnalyticsScreenDaily_day_idx")
  @@index([platform], map: "AnalyticsScreenDaily_platform_idx")
}

model AnalyticsSessionDaily {
  id            Int      @id @default(autoincrement())
  day           DateTime @db.Date
  platform      String   @db.VarChar(10)
  appVersion    String   @db.VarChar(20)
  sessionsCount Int      @default(0)
  installsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([day, platform, appVersion], map: "AnalyticsSessionDaily_composite_key")
  @@index([day], map: "AnalyticsSessionDaily_day_idx")
}

model AnalyticsSummaryReceipt {
  id                   Int      @id @default(autoincrement())
  receivedAt           DateTime @default(now())
  periodStart          DateTime
  periodEnd            DateTime
  platform             String   @db.VarChar(10)
  appVersion           String   @db.VarChar(20)
  runtimeVersion       String?  @db.VarChar(20)
  installHash          String   @db.VarChar(64)
  sessionHash          String   @db.VarChar(64)
  acceptedScreensCount Int      @default(0)
  acceptedActionsCount Int      @default(0)
  acceptedFormsCount   Int      @default(0)
  discardedItemsCount  Int      @default(0)
  validationStatus     String   @db.VarChar(20)
  payloadHash          String   @db.VarChar(64)
  createdAt            DateTime @default(now())
  analyticsUserId      Int?
  /// Quantidade de eventos de jornada aceitos neste summary (0 quando o
  /// recurso está desligado ou o app não enviou `journey`).
  journeyEventsCount   Int      @default(0)

  @@index([appVersion], map: "AnalyticsSummaryReceipt_appVersion_idx")
  @@index([analyticsUserId, receivedAt], map: "AnalyticsSummaryReceipt_user_receivedAt_idx")
  @@index([installHash, receivedAt], map: "AnalyticsSummaryReceipt_install_receivedAt_idx")
  @@index([payloadHash], map: "AnalyticsSummaryReceipt_payloadHash_idx")
  @@index([periodStart], map: "AnalyticsSummaryReceipt_periodStart_idx")
  @@index([platform], map: "AnalyticsSummaryReceipt_platform_idx")
  @@index([receivedAt], map: "AnalyticsSummaryReceipt_receivedAt_idx")
}

/// ─── Jornada do usuário (ANALYTICS_JOURNEY_ENABLED=true) ───────────────────
/// Um aparelho (instalação do app) conhecido. installHash é o mesmo HMAC usado
/// nas tabelas agregadas, então tudo cruza sem expor o UUID bruto do app.
/// Modelo/SO vêm do bloco opcional `device` do summary (expo-device).
model AnalyticsDevice {
  id              Int      @id @default(autoincrement())
  installHash     String   @unique(map: "AnalyticsDevice_installHash_key") @db.VarChar(64)
  platform        String   @db.VarChar(10)
  brand           String?  @db.VarChar(40)
  model           String?  @db.VarChar(80)
  modelId         String?  @db.VarChar(40)
  osName          String?  @db.VarChar(20)
  osVersion       String?  @db.VarChar(20)
  deviceType      String?  @db.VarChar(20)
  timezone        String?  @db.VarChar(60)
  appVersion      String   @db.VarChar(20)
  runtimeVersion  String?  @db.VarChar(20)
  lastSessionHash String?  @db.VarChar(64)
  lastUserId      Int?
  lastIp          String?  @db.VarChar(45)
  summariesCount  Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([lastUserId], map: "AnalyticsDevice_lastUserId_idx")
  @@index([lastSeenAt], map: "AnalyticsDevice_lastSeenAt_idx")
}

/// Vínculo conta ↔ aparelho. Uma linha por (userId, installHash). Responde
/// "em quantos celulares a conta está logada": vínculos com lastSeenAt recente
/// e sem logout posterior.
model AnalyticsUserDevice {
  id              Int       @id @default(autoincrement())
  userId          Int
  installHash     String    @db.VarChar(64)
  platform        String    @db.VarChar(10)
  lastAppVersion  String    @db.VarChar(20)
  lastSessionHash String?   @db.VarChar(64)
  summariesCount  Int       @default(0)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastLoginAt     DateTime?
  lastLogoutAt    DateTime?

  @@unique([userId, installHash], map: "AnalyticsUserDevice_user_install_key")
  @@index([installHash], map: "AnalyticsUserDevice_installHash_idx")
  @@index([userId, lastSeenAt], map: "AnalyticsUserDevice_user_lastSeenAt_idx")
}

enum AnalyticsJourneyEventType {
  SCREEN
  ACTION
  FORM
}

/// Evento individual da jornada (tela/ação/formulário) com horário informado
/// pelo app. Continua chegando em lote, dentro do mesmo summary — não há
/// request por evento. Retenção: ANALYTICS_JOURNEY_TTL_DAYS.
model AnalyticsJourneyEvent {
  id          BigInt                    @id @default(autoincrement())
  occurredAt  DateTime
  receivedAt  DateTime                  @default(now())
  receiptId   Int?
  userId      Int?
  installHash String                    @db.VarChar(64)
  sessionHash String                    @db.VarChar(64)
  platform    String                    @db.VarChar(10)
  appVersion  String                    @db.VarChar(20)
  seq         Int                       @default(0)
  eventType   AnalyticsJourneyEventType
  name        String                    @db.VarChar(80)
  screen      String?                   @db.VarChar(80)
  outcome     String?                   @db.VarChar(20)
  durationMs  Int?

  @@index([userId, occurredAt], map: "AnalyticsJourneyEvent_user_occurredAt_idx")
  @@index([installHash, occurredAt], map: "AnalyticsJourneyEvent_install_occurredAt_idx")
  @@index([sessionHash], map: "AnalyticsJourneyEvent_sessionHash_idx")
  @@index([occurredAt], map: "AnalyticsJourneyEvent_occurredAt_idx")
  @@index([name, occurredAt], map: "AnalyticsJourneyEvent_name_occurredAt_idx")
}

model Document {
  id               Int          @id @default(autoincrement())
  description      String       @db.VarChar(255)
  documentUrl      String       @db.VarChar(500)
  type             DocumentType
  visibleConsultor Boolean      @default(false)
  visibleAssociado Boolean      @default(false)
  visibleBoth      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model FuelSession {
  id            String   @id @default(uuid())
  userId        Int
  valorAntes    Float
  valorDepois   Float?
  diferenca     Float?
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Preenchida (com o id do usuário) enquanto a sessão está PENDING e nula
  /// depois. O índice único sobre ela garante uma sessão pendente por
  /// usuário — o MySQL não tem índice único parcial.
  pendenteChave String?  @unique(map: "FuelSession_pendenteChave_key") @db.VarChar(40)
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FuelSession_userId_fkey")

  @@index([userId, status], map: "FuelSession_userId_status_idx")
}

/// Falhas no fluxo do Clubgas (postos, cartão virtual, total economizado): de
/// qual usuário veio, o que foi enviado e o que o Clubgas respondeu. Sem FK
/// para preservar o histórico mesmo que o usuário seja removido.
/// Gravado por `ClubgasErroLogService` (src/integrations/clubgas).
model ClubgasErroLog {
  id            Int      @id @default(autoincrement())
  /// Usuário do app que fez a chamada.
  userId        Int
  /// CPF/CNPJ enviado ao Clubgas (null quando a falha ocorre antes do envio).
  userDocumento String?  @db.VarChar(20)
  baseOrigin    String?  @db.VarChar(50)
  /// POSTOS | CARTAO_VIRTUAL | TOTAL_ECONOMIZADO
  operacao      String   @db.VarChar(30)
  /// APP (requisição do associado) | JOB_ECONOMIA (verificação pós-abastecimento)
  origem        String   @db.VarChar(20)
  chassi        String?  @db.VarChar(100)
  placa         String?  @db.VarChar(20)
  /// Classificação da falha — ver `ClubgasErroCategoria` (clubgas.erro.ts).
  categoria     String   @db.VarChar(30)
  /// Status HTTP devolvido pelo Clubgas (null: timeout, sem conexão ou falha antes da chamada).
  httpStatus    Int?
  /// Mensagem do Clubgas ou do erro de rede, truncada.
  mensagem      String   @db.VarChar(500)
  /// Corpo devolvido pelo Clubgas, truncado.
  resposta      Json?
  duracaoMs     Int?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt], map: "ClubgasErroLog_userId_createdAt_idx")
  @@index([categoria, createdAt], map: "ClubgasErroLog_categoria_createdAt_idx")
  @@index([createdAt], map: "ClubgasErroLog_createdAt_idx")
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int
  expoPushToken String    @db.VarChar(255)
  title         String    @db.VarChar(255)
  body          String    @db.Text
  data          Json
  read          Boolean   @default(false)
  sentAt        DateTime  @default(now())
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([createdAt], map: "Notification_createdAt_idx")
  @@index([sentAt], map: "Notification_sentAt_idx")
  @@index([userId, read], map: "Notification_userId_read_idx")
  /// Caixa de entrada do app: notificações não excluídas do usuário, da mais recente para a mais antiga.
  @@index([userId, deleted, sentAt], map: "Notification_userId_deleted_sentAt_idx")
}

model Reinspection {
  id                       Int                           @id @default(autoincrement())
  userVehicleId            Int
  vehicleType              ReinspectionVehicleType
  status                   ReinspectionStatus            @default(PENDENTE)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  codigoVeiculo            Int?
  /// Resultado consolidado do último envio de fotos à Hinova (eixo separado do `status`).
  hinovaEnvioStatus        ReinspectionHinovaEnvioStatus @default(NAO_ENVIADA)
  hinovaUltimoEnvioEm      DateTime?
  /// Boleto de reativação: consolidado da criação (eixo separado do `status`).
  boletoStatus             ReinspectionBoletoStatus      @default(NAO_GERADO)
  boletoTentativas         Int                           @default(0)
  boletoUltimaTentativaEm  DateTime?
  boletoProximaTentativaEm DateTime?
  /// Início da janela de retry corrente (zera a cada entrada em PENDENTE_RETRY vinda de outro estado).
  boletoRetryInicioEm      DateTime?
  boletoUltimoErro         String?                       @db.VarChar(500)
  boletoNossoNumero        String?                       @db.VarChar(50)
  /// CRIADO_APP (cadastrado pela API) | ADOTADO_SGA (já existia no SGA, criado manualmente)
  boletoOrigem             String?                       @db.VarChar(20)
  /// Lease da geração do boleto: enquanto `boletoLeaseAte` estiver no futuro,
  /// só o dono do lease cadastra boleto no SGA para esta revistoria. Impede
  /// que aprovação, retry e "gerar agora" cadastrem dois boletos.
  boletoLeaseAte           DateTime?
  boletoLeaseDono          String?                       @db.VarChar(40)
  /// Lease do envio de fotos à Hinova: enquanto estiver no futuro, outro envio
  /// da mesma revistoria é recusado (duas chamadas liam as mesmas fotos
  /// pendentes e postavam em dobro).
  hinovaEnvioLeaseAte      DateTime?
  userVehicle              UserVehicle                   @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "Reinspection_userVehicleId_fkey")
  photos                   ReinspectionPhoto[]
  hinovaEnvios             ReinspectionHinovaEnvio[]

  @@index([status], map: "Reinspection_status_idx")
  @@index([userVehicleId], map: "Reinspection_userVehicleId_idx")
  @@index([hinovaEnvioStatus], map: "Reinspection_hinovaEnvioStatus_idx")
  @@index([boletoStatus], map: "Reinspection_boletoStatus_idx")
  @@index([userVehicleId, createdAt], map: "Reinspection_userVehicleId_createdAt_idx")
  /// Varredor do retry de boleto: revistorias com tentativa devida.
  @@index([boletoStatus, boletoProximaTentativaEm], map: "Reinspection_boletoStatus_proximaTentativa_idx")
}

/// Uma linha por tentativa de envio de fotos de revistoria à Hinova
/// (`/veiculo/foto/cadastrar`), seja na aprovação ou em reenvio manual pelo painel.
model ReinspectionHinovaEnvio {
  id                  Int                           @id @default(autoincrement())
  reinspectionId      Int
  origem              ReinspectionHinovaEnvioOrigem
  status              ReinspectionHinovaEnvioStatus
  baseOrigin          String                        @db.VarChar(30)
  codigoVeiculo       Int?
  /// Usuário do painel que disparou o reenvio (null quando origem = APROVACAO sem contexto).
  adminPanelUserId    Int?
  adminPanelUserEmail String?                       @db.VarChar(150)
  totalFotos          Int                           @default(0)
  totalInseridas      Int                           @default(0)
  totalFalhas         Int                           @default(0)
  /// Ids das fotos incluídas na tentativa.
  photoIds            Json
  httpStatus          Int?
  /// Resposta da Hinova (sem binários), truncada.
  responseBody        Json?
  errorMessage        String?                       @db.VarChar(500)
  duracaoMs           Int?
  createdAt           DateTime                      @default(now())
  reinspection        Reinspection                  @relation(fields: [reinspectionId], references: [id], onDelete: Cascade, map: "ReinspectionHinovaEnvio_reinspectionId_fkey")

  @@index([reinspectionId], map: "ReinspectionHinovaEnvio_reinspectionId_idx")
  @@index([createdAt], map: "ReinspectionHinovaEnvio_createdAt_idx")
  @@index([status], map: "ReinspectionHinovaEnvio_status_idx")
}

model ReinspectionAnalyst {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReinspectionPayment {
  id                     Int         @id @default(autoincrement())
  userVehicleId          Int
  nossoNumero            String?     @unique(map: "ReinspectionPayment_nossoNumero_key") @db.VarChar(50)
  linhaDigitavel         String?     @db.VarChar(255)
  linkBoleto             String?     @db.VarChar(500)
  situacaoBoleto         String      @default("PENDENTE") @db.VarChar(100)
  boletoCriadoEm         DateTime    @default(now())
  pago                   Boolean     @default(false)
  pagoEm                 DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  cancelado              Boolean     @default(false)
  /// Revistoria que originou o boleto (null nos registros anteriores a 2026-10-22).
  reinspectionId         Int?
  /// Quando o SGA aceitou a reativação do veículo após o pagamento. Enquanto
  /// for null com `pago = true`, a verificação segue tentando reativar.
  reativadoEm            DateTime?
  /// Quando o e-mail de "boleto pago" foi enviado à equipe (envio único).
  pagoNotificadoEm       DateTime?
  /// WhatsApp (Suri) de boleto pago enviado ao associado: marcador de envio único.
  suriNotificadoEm       DateTime?
  /// Memória de cálculo do valor quando a regra da empresa cobra encargos por
  /// atraso (valor base, multa, mora, dias, boleto em aberto que serviu de
  /// base e a situação do cancelamento dele). Nulo = boleto pelo valor base.
  encargos               Json?
  /// Verificação de pagamento por varredura (substitui um job repetível por
  /// boleto): o varredor pega as linhas com `proximaConsultaEm` vencido e
  /// `verificacaoEncerradaEm` nulo. Os campos abaixo são o que o job
  /// repetível carregava no payload.
  proximaConsultaEm      DateTime?
  verificacaoEncerradaEm DateTime?
  baseOrigin             String?     @db.VarChar(50)
  codigoVeiculo          String?     @db.VarChar(50)
  codigoAssociado        Int?
  nomeAssociado          String?     @db.VarChar(255)
  telefoneAssociado      String?     @db.VarChar(30)
  userVehicle            UserVehicle @relation(fields: [userVehicleId], references: [id], onDelete: Cascade, map: "ReinspectionPayment_userVehicleId_fkey")

  @@index([boletoCriadoEm], map: "ReinspectionPayment_boletoCriadoEm_idx")
  @@index([pago], map: "ReinspectionPayment_pago_idx")
  @@index([situacaoBoleto], map: "ReinspectionPayment_situacaoBoleto_idx")
  @@index([userVehicleId], map: "ReinspectionPayment_userVehicleId_idx")
  @@index([reinspectionId], map: "ReinspectionPayment_reinspectionId_idx")
  @@index([verificacaoEncerradaEm, proximaConsultaEm], map: "ReinspectionPayment_varredura_idx")
}

/// Execução da rotina diária de notificações de boleto (uma linha por
/// tenant × tipo de mensagem × data-alvo). Concentra as métricas de cobertura.
model BoletoNotificacaoExecucao {
  id                     Int                             @id @default(autoincrement())
  tenant                 String                          @db.VarChar(50)
  tipoMensagem           BoletoNotificacaoTipo
  dataReferencia         DateTime                        @db.Date
  dataAlvo               DateTime                        @db.Date
  status                 BoletoNotificacaoExecucaoStatus @default(EM_ANDAMENTO)
  origem                 String                          @default("AGENDADA") @db.VarChar(20)
